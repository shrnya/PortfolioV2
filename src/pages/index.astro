---
import Base from '../layouts/Base.astro';
import Testimonials from '../components/Testimonials.astro';
import { arrow, line } from '../lib/rough';

const featured = [
  {
    href: '/work/design-system/', img: '/media/ds/after-light.jpg', company: 'Ecolibrium · 2026',
    title: 'Can a product get a new look without losing the people who know it by heart?',
    line: 'I rebuilt the design system behind SmartSense, Ecolibrium’s energy platform. The familiar dark theme stayed, a light one joined it, and both run on tokens the code can use.',
    tags: ['Design system', 'Theming', 'Components'],
  },
  {
    href: '/work/sld/', img: '/media/sld/overview.jpg', company: 'Ecolibrium · 2026',
    title: 'Where is all that energy actually going?',
    line: 'I designed, end to end, an interactive map of a building’s power network, so engineers and managers alike can follow energy from the grid to each machine.',
    tags: ['Data visualisation', 'Complex systems', 'End to end'],
  },
  {
    href: '/work/sustainlab/', img: '/media/home/sustainlab.jpg', company: 'SustainLab · 2024',
    title: 'How do you design for a law that didn’t exist last year?',
    line: 'I helped turn a 284-page EU regulation into guided questions that sustainability teams could actually answer, and reworked how design handed work to developers.',
    tags: ['B2B SaaS', 'Regulation', 'Dev handoff'],
  },
];
const more = [
  { href: '/work/spider-club/', img: '/media/scob/mockup.jpg', title: 'Spider Club of Belgaum', line: 'A database of 55+ local spider species, built from four years of field research.' },
  { href: '/work/architecture/', img: '/media/arch/yurt-built.jpg', title: 'Architecture and interiors', line: 'Where it all started: a bamboo yurt, an office in Mumbai and an apartment in Ho Chi Minh City.' },
];
const quotes = [
  {
    text: 'Sharanya was fantastic to collaborate with! From day one, she brought fresh ideas and a solid eye for detail, always keeping the user front and center in her designs. One of her standout contributions was creating a super helpful template for handing over designs from the UX team to the dev team, which really streamlined our workflow. She’s also a quick learner who was always open to feedback, and her positive attitude made her a great part of the team.',
    name: 'Soe Y Paing', role: 'UX Designer, SustainLab', photo: '/media/people/soe.jpg', href: 'https://www.linkedin.com/in/soe-yan-paing-21941384/',
  },
];
const swoop = line(4, 10, 196, 6, 51, 3);
const down = arrow(20, 4, 26, 52, 52);
---
<Base title="Sharanya Jagdeeshchandran · Product designer">
  <section class="hero sheet">
    <p class="hand hi">Hi, I’m Sharanya ✤</p>
    <h1>A designer who thrives where design meets <span class="imp">impact<svg class="sw boil" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true"><path d={swoop} /></svg></span>.</h1>
    <p class="lede">I’m a product designer with a background in architecture. I love untangling complex problems and turning them into products that feel simple to use.</p>
    <ul class="where">
      <li><span class="k">Currently at</span> <a href="/work/design-system/"><b>Ecolibrium</b></a>, designing an energy management platform</li>
      <li><span class="k">Previously at</span> <a href="/work/sustainlab/"><b>SustainLab</b></a>, designing sustainability reporting software</li>
    </ul>
    <a class="peek hand" href="#work">see my work<svg class="boil" viewBox="0 0 30 56" aria-hidden="true"><path d={down} /></svg></a>
  </section>

  <section id="work" class="work sheet" aria-labelledby="work-h">
    <header class="sec-head">
      <h2 id="work-h">Selected work</h2>
    </header>
    <ol class="feat">
      {featured.map((f, i) => (
        <li class:list={['row', { flip: i % 2 === 1 }]}>
          <a class="shot" href={f.href} tabindex="-1" aria-hidden="true"><img src={f.img} alt="" loading={i ? 'lazy' : 'eager'} /></a>
          <div class="txt">
            <p class="eyebrow">{f.company}</p>
            <h3><a href={f.href}>{f.title}</a></h3>
            <p>{f.line}</p>
            <ul class="tags">{f.tags.map((t) => <li>{t}</li>)}</ul>
            <a class="go" href={f.href}>Read the case study <span aria-hidden="true">→</span></a>
          </div>
        </li>
      ))}
    </ol>

    <h2 class="more-h">More of my work</h2>
    <ul class="more">
      {more.map((m) => (
        <li>
          <a href={m.href}>
            <img src={m.img} alt="" loading="lazy" />
            <span class="mt">{m.title} <span aria-hidden="true">→</span></span>
            <span class="ml">{m.line}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="kind sheet" aria-labelledby="kind-h">
    <header class="sec-head">
      <h2 id="kind-h">What it’s like to work with me</h2>
      <p class="hand">don’t just take my word for it :)</p>
    </header>
    <Testimonials quotes={quotes} />
  </section>

  <section id="about" class="about sheet" aria-labelledby="about-h">
    <img class="me" src="/media/people/sharanya.jpg" alt="Sharanya smiling, holding a small dog" width="700" height="933" loading="lazy" />
    <div class="story">
      <p class="eyebrow">About</p>
      <h2 id="about-h">I’m Sharanya, nice to meet you ✤</h2>
      <p>I spent over two years as an architect before a UX workshop in 2024 pulled me into digital design. I still start every project the way I’d start a building: understand the people, find the structure, then make it easy to use.</p>
      <p>Off screen, I’m catching up on pop culture or geeking out over spiders (yes, web design runs deep) :)</p>
    </div>
  </section>
</Base>

<style>
  .hero { display: flex; flex-direction: column; gap: 1.3rem; padding-block: 4rem 3rem; }
  @media (min-width: 900px) { .hero { padding-block: 6.5rem 4.5rem; } }
  .hi { font-size: 1.6rem; }
  h1 { font-size: clamp(2.5rem, 7vw, 5.2rem); font-weight: 800; letter-spacing: -.035em; line-height: 1; max-width: 19ch; }
  .imp { position: relative; white-space: nowrap; color: var(--pencil); }
  .sw { position: absolute; left: -2%; bottom: -.12em; width: 104%; height: .25em; overflow: visible; }
  .sw path { fill: none; stroke: var(--pencil); stroke-width: 3; stroke-linecap: round; }
  .lede { font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.5; max-width: 36rem; }
  .where { list-style: none; margin: .2rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .45rem; font-size: 1.05rem; }
  .where .k { font-family: var(--f-mono); font-size: .74rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin-right: .35rem; }
  .where a { text-decoration: none; border-bottom: 1.5px solid var(--pencil); }
  .where a:hover { color: var(--pencil); }
  .peek { align-self: flex-start; display: inline-flex; align-items: flex-start; gap: .3rem; margin-top: 1.5rem; font-size: 1.15rem; text-decoration: none; }
  .peek svg { width: 1.3rem; height: 2.6rem; overflow: visible; }
  .peek path { fill: none; stroke: var(--pencil); stroke-width: 2; stroke-linecap: round; }
  @media (prefers-reduced-motion: no-preference) { .peek svg { animation: bob 1.8s ease-in-out infinite; } }
  @keyframes bob { 50% { transform: translateY(5px); } }

  .work, .about, .kind { padding-block: 5rem 0; }
  .sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem 1.5rem; margin-bottom: 2rem; }
  .sec-head h2, .story h2, .more-h { font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 800; letter-spacing: -.02em; }
  .sec-head .hand { font-size: 1.15rem; }

  .feat { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4.5rem; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem 3rem; align-items: center; }
  @media (min-width: 860px) { .row { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } .row.flip .shot { order: 2; } }
  .shot { display: block; border: 1.5px solid var(--ink); border-radius: 10px; overflow: hidden; background: var(--sheet); transition: transform .25s, box-shadow .25s; }
  .shot img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .row:hover .shot { transform: rotate(-.6deg) translateY(-3px); box-shadow: 6px 6px 0 var(--pencil); }
  .row.flip:hover .shot { transform: rotate(.6deg) translateY(-3px); }
  .txt { display: flex; flex-direction: column; gap: .7rem; min-width: 0; }
  h3 { font-size: clamp(1.35rem, 2.4vw, 1.75rem); font-weight: 800; letter-spacing: -.015em; line-height: 1.15; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .txt > p:not(.eyebrow) { color: var(--muted); line-height: 1.5; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
  .tags li { font-family: var(--f-mono); font-size: .7rem; letter-spacing: .03em; border: 1px solid var(--rule); border-radius: 999px; padding: .15rem .6rem; color: var(--muted); }
  .go { font-family: var(--f-hand); font-size: 1.12rem; color: var(--pencil); text-decoration: none; align-self: flex-start; }
  .go span { display: inline-block; transition: transform .2s; }
  .row:hover .go span { transform: translateX(5px); }

  .more-h { font-size: clamp(1.3rem, 2.4vw, 1.6rem); margin: 5rem 0 1.25rem; padding-top: 2rem; border-top: 1.5px solid var(--ink); }
  .more { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem 2rem; }
  @media (min-width: 640px) { .more { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .more a { display: flex; flex-direction: column; gap: .4rem; text-decoration: none; }
  .more img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; border: 1px solid var(--rule); transition: transform .25s; }
  .more a:hover img { transform: rotate(-.8deg); }
  .mt { font-family: var(--f-display); font-weight: 800; font-size: 1.1rem; }
  .more a:hover .mt { text-decoration: underline; text-underline-offset: 3px; }
  .ml { color: var(--muted); font-size: .97rem; line-height: 1.45; }

  .about { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem 3.5rem; align-items: center; }
  @media (min-width: 760px) { .about { grid-template-columns: minmax(0, 17rem) minmax(0, 1fr); } }
  .me { width: 100%; max-width: 17rem; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; border: 1.5px solid var(--ink); transform: rotate(-1.5deg); }
  .story { display: flex; flex-direction: column; gap: 1rem; max-width: var(--col-w); min-width: 0; }
  .story p:not(.eyebrow) { font-size: 1.1rem; }
</style>
