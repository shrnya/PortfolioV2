---
import Base from '../layouts/Base.astro';
import { line } from '../lib/rough';

const resume = 'https://drive.google.com/file/d/15tVwUM-jkmzby2MVAa0smwRkCzmqHJ-Z/view';
const work = [
  { href: '/work/design-system/', img: '/media/ds/after-light.jpg', shot: true, company: 'Ecolibrium', title: 'A new look that didn’t leave customers behind', tags: ['Design system', 'Theming'] },
  { href: '/work/sld/', img: '/media/sld/overview.jpg', shot: true, company: 'Ecolibrium', title: 'Following the power to find the leak', tags: ['Data viz', 'End to end'] },
  { href: '/work/sustainlab/', img: '/media/home/sustainlab.jpg', shot: true, company: 'SustainLab', title: 'A 284-page law, one question at a time', tags: ['B2B SaaS', 'Handoff'] },
  { href: '/work/spider-club/', img: '/media/scob/mockup.jpg', shot: false, company: 'Spider Club of Belgaum', title: 'A home for 55+ local spider species', tags: ['Database', 'IA'] },
  { href: '/work/architecture/', img: '/media/arch/yurt-built.jpg', shot: false, company: 'Architecture', title: 'The archive: buildings and interiors', tags: ['Gallery'] },
];
const swoop = line(4, 10, 196, 6, 51, 3);
---
<Base title="Sharanya JC · Product designer">
  <section class="hero sheet">
    <h1>Sharanya <span class="jc">JC<svg class="sw boil" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true"><path d={swoop} /></svg></span>.</h1>
    <p class="tag hand">a designer who thrives where design meets impact ✤</p>
    <ul class="at">
      <li><span class="k">@</span> <b>Ecolibrium</b> Product Designer</li>
      <li><span class="k">prev @</span> <b>SustainLab</b> Product Design Intern</li>
    </ul>
    <ul class="links">
      <li><a href={resume} rel="noopener">résumé ↗</a></li>
      <li><a href="https://www.linkedin.com/in/sharanyajc" rel="noopener">linkedin ↗</a></li>
      <li><a href="mailto:sharanyajc@gmail.com?subject=Let%27s%20talk">email ↗</a></li>
    </ul>
  </section>

  <section id="work" class="work sheet" aria-labelledby="work-h">
    <header class="wh">
      <p class="eyebrow">01</p>
      <h2 id="work-h">Selected<br />Work.</h2>
    </header>
    <ul class="grid">
      {work.map((w, i) => (
        <li class:list={[i < 2 ? 'wide' : 'third']}>
          <a class="card surface" href={w.href}>
            <span class:list={['pic', { shot: w.shot }]}><img src={w.img} alt="" loading={i < 2 ? 'eager' : 'lazy'} /></span>
            <span class="cap">
              <span class="co">{w.company}</span>
              <span class="t">{w.title}</span>
              <span class="tags">{w.tags.map((t) => <span>{t}</span>)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero { display: flex; flex-direction: column; gap: 1rem; padding-block: 3.5rem 2.5rem; }
  @media (min-width: 900px) { .hero { padding-block: 6rem 3.5rem; } }
  h1 { font-size: clamp(3.2rem, 11vw, 7rem); font-weight: 800; letter-spacing: -.045em; line-height: .95; }
  .jc { position: relative; color: var(--pencil); }
  .sw { position: absolute; left: -4%; bottom: -.1em; width: 108%; height: .2em; overflow: visible; }
  .sw path { fill: none; stroke: var(--pencil); stroke-width: 3; stroke-linecap: round; }
  .tag { font-size: clamp(1.25rem, 3vw, 1.6rem); }
  .at { list-style: none; margin: .4rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .3rem; font-family: var(--f-display); font-size: 1.05rem; }
  .at .k { font-family: var(--f-mono); font-size: .78rem; color: var(--muted); margin-right: .2rem; }
  .at b { margin-right: .3rem; }
  .links { list-style: none; margin: .6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; font-family: var(--f-mono); font-size: .9rem; }
  .links a { text-decoration: none; border-bottom: 1.5px solid var(--pencil); }
  .links a:hover { color: var(--pencil); }

  .work { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem 2rem; padding-block: 2rem 0; }
  @media (min-width: 900px) { .work { grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); } }
  .wh h2 { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin-top: .4rem; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(6, minmax(0, 1fr)); } .wide { grid-column: span 3; } .third { grid-column: span 2; } }
  @media (min-width: 640px) and (max-width: 899px) { .third:last-child { grid-column: span 6; } .third { grid-column: span 3; } }
  .card { position: relative; display: block; height: 100%; min-height: 15rem; background: var(--paper); border-radius: 8px; overflow: hidden; text-decoration: none; }
  .wide .card { aspect-ratio: 4 / 3; }
  .third .card { aspect-ratio: 4 / 5; }
  @media (max-width: 639px) { .wide .card, .third .card { aspect-ratio: 4 / 3; } }
  .pic { position: absolute; inset: 0; }
  .pic img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .pic.shot { inset: 1.1rem 1.1rem auto; height: 70%; border: 1.5px solid var(--pencil); border-radius: 6px; overflow: hidden; background: var(--sheet); }
  .pic.shot img { object-position: top left; }
  .card:hover .pic img { transform: scale(1.03); }
  .cap {
    position: absolute; left: 1rem; bottom: 1rem; right: 1rem; max-width: 22rem; display: flex; flex-direction: column; gap: .3rem;
    background: var(--paper); border: 1.5px solid var(--pencil); padding: .65rem .8rem .7rem; box-shadow: 4px 4px 0 var(--pencil); transition: transform .25s;
  }
  .card:hover .cap { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--pencil); }
  .co { font-family: var(--f-mono); font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; color: var(--pencil); }
  .t { font-family: var(--f-display); font-weight: 800; font-size: 1.08rem; line-height: 1.2; letter-spacing: -.01em; color: var(--ink); }
  .tags { display: flex; flex-wrap: wrap; gap: .3rem; }
  .tags span { font-family: var(--f-mono); font-size: .64rem; letter-spacing: .04em; text-transform: uppercase; color: var(--pencil); border: 1px solid var(--pencil-soft); padding: .05rem .4rem; }
</style>
