---
import Base from '../layouts/Base.astro';
import SketchToSystem from '../components/SketchToSystem.astro';
import EntryCard from '../components/EntryCard.astro';

const entries = [
  {
    n: '01', href: '/work/sustainlab/', status: 'Read the case study',
    title: 'How do you design for a law that didn’t exist last year?',
    line: 'At SustainLab, I helped turn a 284-page EU regulation into guided questions that sustainability teams could actually answer.',
    tags: ['SustainLab', 'B2B SaaS', '2024'],
  },
  {
    n: '02', href: '/work/design-system/', status: 'Read the case study',
    title: 'Can a product get a new look without losing the people who know it by heart?',
    line: 'I rebuilt the design system behind Ecolibrium’s energy platform: the familiar dark theme stayed, and a light one joined it.',
    tags: ['Ecolibrium', 'Design system', '2026'],
  },
  {
    n: '03', href: '/work/sld/', status: 'Read the case study',
    title: 'Where is all that energy actually going?',
    line: 'I designed, end to end, an interactive map of a building’s power network, so anyone can follow energy from the grid to each machine.',
    tags: ['Ecolibrium', 'Energy management', '2026'],
  },
  {
    n: '04', href: '/work/spider-club/', status: 'Redesign in progress',
    title: 'What do you do when Google can’t identify the spider you just spotted?',
    line: 'You build the database yourself. Four years of scattered field research, now 55+ species people can actually browse.',
    tags: ['Spider Club of Belgaum', 'Information architecture'],
  },
  {
    n: '05', href: '/work/architecture/', status: 'Peek at my roots',
    title: 'What does a bamboo yurt in Auroville have to do with product design?',
    line: 'Probably more than you’d think. Architecture school, natural buildings and luxury interiors taught me user-centred thinking long before I touched a wireframe.',
    tags: ['Architecture', 'Interiors', '2021 to 2023'],
  },
] as const;
---
<Base title="Sharanya Jagdeeshchandran · Product designer">
  <section class="hero sheet">
    <div class="intro">
      <p class="hand hi">Hi, I’m Sharanya ✤</p>
      <h1>A designer who thrives where design meets <span class="hl">impact</span>.</h1>
      <p class="lede">Architect turned product designer. I design energy and sustainability software, where the data is dense and the people using it have real decisions to make.</p>
      <p class="hand now">Now: Ecolibrium. Before that: SustainLab.</p>
    </div>
    <SketchToSystem />
  </section>

  <section id="work" class="work sheet" aria-labelledby="work-h">
    <header class="sec-head">
      <h2 id="work-h">Selected work</h2>
      <p class="hand">Every project starts with a question.</p>
    </header>
    <ul class="entries">
      {entries.map((e) => <EntryCard {...e} tags={[...e.tags]} />)}
    </ul>
  </section>

  <section class="kind sheet" aria-labelledby="kind-h">
    <header class="sec-head">
      <h2 id="kind-h">What it’s like to work with me</h2>
    </header>
    <p class="kind-intro">Whether it’s brainstorming big ideas or sweating the small details, I try to make work both productive and fun. I like to think I’m a delight to work with, but don’t just take my word for it :)</p>
    <figure class="quote">
      <blockquote>“Sharanya was fantastic to collaborate with! From day one, she brought fresh ideas and a solid eye for detail, always keeping the user front and center in her designs. One of her standout contributions was creating a super helpful template for handing over designs from the UX team to the dev team, which really streamlined our workflow. She’s also a quick learner who was always open to feedback, and her positive attitude made her a great part of the team.”</blockquote>
      <figcaption>
        <img class="face" src="/media/people/soe.jpg" alt="" width="56" height="56" loading="lazy" />
        <span><b>Soe Y Paing</b><br />UX Designer, SustainLab</span>
      </figcaption>
    </figure>
  </section>

  <section id="about" class="about sheet" aria-labelledby="about-h">
    <div class="label">
      <img class="me" src="/media/people/sharanya.jpg" alt="Sharanya smiling" width="600" height="600" loading="lazy" />
      <dl>
        <div><dt>Trained as</dt><dd>Architect</dd></div>
        <div><dt>Now</dt><dd>Product designer at Ecolibrium</dd></div>
        <div><dt>Curious about</dt><dd>Tech that helps the planet</dd></div>
        <div><dt>Off screen</dt><dd>Spiders, pop culture, quiet water</dd></div>
      </dl>
    </div>
    <div class="story">
      <p class="eyebrow">About</p>
      <h2 id="about-h">I’m Sharanya, nice to meet you ✤</h2>
      <p>I’ve always been drawn to digital design and how quickly it reaches people. In early 2024, after over two years as an architect, a UX workshop got me hooked. By July I was interning at SustainLab, working where tech, design and impact meet, and that confirmed UX was my calling.</p>
      <p>Today I’m a product designer at Ecolibrium, designing energy management software. Architecture still shapes how I work: I find the structure first, then make it easy to read.</p>
      <p>I’m curious about how technology can support sustainability, and how design can bridge the digital and the physical.</p>
      <p>When I’m not solving design problems, I’m catching up on pop culture, geeking out over spiders (yes, web design runs deep), or unwinding by tranquil waters. Always up for a good conversation, a spontaneous adventure or a perfectly timed bad joke :)</p>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; padding-block: 3rem 2rem; align-items: center; }
  @media (min-width: 900px) { .hero { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 3.5rem; padding-block: 4.5rem 3rem; } }
  .intro { display: flex; flex-direction: column; gap: 1.1rem; min-width: 0; }
  h1 { font-size: clamp(2.3rem, 5.4vw, 3.9rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.02; }
  .lede { font-size: 1.2rem; line-height: 1.5; max-width: 32rem; }
  .now { font-size: 1.1rem; }
  .hi { font-size: 1.5rem; }

  .work, .about, .kind { padding-block: 5rem 0; }
  .kind-intro { max-width: var(--col-w); margin-bottom: 1.5rem; }
  .quote { margin: 0; max-width: 46rem; border: 2px solid var(--pencil); border-radius: 18px 22px 20px 16px; padding: 1.4rem 1.5rem; transform: rotate(-.4deg); display: flex; flex-direction: column; gap: 1rem; }
  .quote blockquote { margin: 0; font-size: 1.12rem; line-height: 1.55; }
  .quote figcaption { display: flex; align-items: center; gap: .8rem; font-family: var(--f-display); font-size: .92rem; line-height: 1.35; }
  .face { width: 3.5rem; height: 3.5rem; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--ink); background: var(--sheet); }
  .sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem 1.5rem; margin-bottom: 1.25rem; }
  .sec-head h2, .story h2 { font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 800; letter-spacing: -.02em; }
  .sec-head .hand { font-size: 1.05rem; }
  .entries { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 3rem; margin: 0; padding: 0; }
  @media (min-width: 860px) { .entries { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .about { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem 3.5rem; align-items: start; }
  @media (min-width: 860px) { .about { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); } }
  .label {
    background: var(--sheet); border: 1.5px solid var(--ink); border-radius: 4px; padding: 1rem 1.1rem 1.1rem;
    display: flex; flex-direction: column; gap: .8rem; transform: rotate(-1deg); position: relative;
  }
  .label::before { content: ""; position: absolute; top: -9px; left: 1.2rem; width: 4.5rem; height: 1.2rem; background: var(--tape); transform: rotate(-4deg); }
  .me { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 3px; background: var(--paper); }
  dl { margin: 0; display: flex; flex-direction: column; gap: .55rem; }
  dl div { display: grid; grid-template-columns: 6.2rem minmax(0, 1fr); gap: .75rem; border-top: 1px solid var(--rule); padding-top: .5rem; }
  dt { font-family: var(--f-mono); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); padding-top: .15rem; }
  dd { margin: 0; font-family: var(--f-hand); font-size: 1.05rem; line-height: 1.3; }
  .story { display: flex; flex-direction: column; gap: 1rem; max-width: var(--col-w); min-width: 0; }
</style>
