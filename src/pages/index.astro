---
import Base from '../layouts/Base.astro';
import { line } from '../lib/rough';

const resume = 'https://drive.google.com/file/d/15tVwUM-jkmzby2MVAa0smwRkCzmqHJ-Z/view';
const roles = [
  { at: 'Ecolibrium', what: 'Product Designer', when: 'Sep 2025 to now' },
  { at: 'SustainLab', what: 'Product Design Intern', when: 'Jul to Nov 2024' },
  { at: 'Kriya', what: 'Architect', when: 'Feb 2022 to Sep 2023' },
];
const featured = [
  {
    href: '/work/design-system/', img: '/media/ds/after-light.jpg', company: 'Ecolibrium',
    title: 'A new look that didn’t leave customers behind',
    tags: ['Design system', 'Theming'],
  },
  {
    href: '/work/sld/', img: '/media/sld/overview.jpg', company: 'Ecolibrium',
    title: 'Following the power to find the leak',
    tags: ['Data visualisation', 'End to end'],
  },
  {
    href: '/work/sustainlab/', img: '/media/home/sustainlab.jpg', company: 'SustainLab',
    title: 'A 284-page law, one question at a time',
    tags: ['B2B SaaS', 'Dev handoff'],
  },
];
const more = [
  { href: '/work/spider-club/', title: 'Spider Club of Belgaum', tags: 'Database · Information architecture', status: 'Redesign in progress' },
  { href: '/work/architecture/', title: 'Architecture and interiors', tags: 'Archive · 2021 to 2023', status: 'See the archive' },
];
const swoop = line(4, 10, 196, 6, 51, 3);
---
<Base title="Sharanya JC · Product designer">
  <section class="hero sheet">
    <h1>Sharanya <span class="jc">JC<svg class="sw boil" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true"><path d={swoop} /></svg></span>.</h1>
    <p class="tag hand">a designer who thrives where design meets impact ✤</p>
    <ul class="at">
      <li><span class="k">@</span> <b>Ecolibrium</b> Product Designer</li>
      <li><span class="k">prev @</span> <b>SustainLab</b> Product Design Intern</li>
      <li><span class="k">before that</span> Architect</li>
    </ul>
    <ul class="links">
      <li><a href={resume} rel="noopener">résumé ↗</a></li>
      <li><a href="https://www.linkedin.com/in/sharanyajc" rel="noopener">linkedin ↗</a></li>
      <li><a href="mailto:sharanyajc@gmail.com?subject=Let%27s%20talk">email ↗</a></li>
    </ul>
  </section>

  <section class="exp sheet" aria-labelledby="exp-h">
    <h2 id="exp-h" class="eyebrow">Experience</h2>
    <ul>
      {roles.map((r) => <li><b>{r.at}</b><span>{r.what}</span><span class="when">{r.when}</span></li>)}
    </ul>
  </section>

  <section id="work" class="work sheet" aria-labelledby="work-h">
    <h2 id="work-h" class="eyebrow">Selected work</h2>
    <ul class="cards">
      {featured.map((f, i) => (
        <li class:list={{ big: i === 0 }}>
          <a href={f.href}>
            <span class="img"><img src={f.img} alt="" loading={i ? 'lazy' : 'eager'} /></span>
            <span class="co">{f.company}</span>
            <span class="t">{f.title}</span>
            <span class="tags">{f.tags.join(' · ')}</span>
          </a>
        </li>
      ))}
    </ul>

    <h2 class="eyebrow more-h">More work</h2>
    <ul class="index">
      {more.map((m) => (
        <li><a href={m.href}><span class="t">{m.title}</span><span class="tags">{m.tags}</span><span class="st hand">{m.status} →</span></a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero { display: flex; flex-direction: column; gap: 1rem; padding-block: 3.5rem 2.5rem; }
  @media (min-width: 900px) { .hero { padding-block: 6rem 3.5rem; } }
  h1 { font-size: clamp(3.2rem, 11vw, 7rem); font-weight: 800; letter-spacing: -.045em; line-height: .95; }
  .jc { position: relative; color: var(--pencil); }
  .sw { position: absolute; left: -4%; bottom: -.1em; width: 108%; height: .2em; overflow: visible; }
  .sw path { fill: none; stroke: var(--pencil); stroke-width: 3; stroke-linecap: round; }
  .tag { font-size: clamp(1.25rem, 3vw, 1.6rem); }
  .at { list-style: none; margin: .4rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .3rem; font-family: var(--f-display); font-size: 1.05rem; }
  .at .k { font-family: var(--f-mono); font-size: .78rem; color: var(--muted); margin-right: .2rem; }
  .at b { margin-right: .3rem; }
  .links { list-style: none; margin: .6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; font-family: var(--f-mono); font-size: .9rem; }
  .links a { text-decoration: none; border-bottom: 1.5px solid var(--pencil); }
  .links a:hover { color: var(--pencil); }

  .eyebrow { margin: 0 0 1rem; }
  .exp { padding-block: 1.5rem 0; }
  .exp ul { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); max-width: 44rem; }
  .exp li { display: grid; grid-template-columns: minmax(0, 8rem) minmax(0, 1fr) auto; gap: .5rem 1rem; padding: .7rem 0; border-bottom: 1px solid var(--rule); font-size: 1rem; }
  .exp b { font-family: var(--f-display); }
  .when { font-family: var(--f-mono); font-size: .8rem; color: var(--muted); padding-top: .15rem; }
  @media (max-width: 520px) { .exp li { grid-template-columns: minmax(0, 1fr) auto; } .exp li span:not(.when) { grid-column: 1; grid-row: 2; color: var(--muted); } }

  .work { padding-block: 4rem 0; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem 2rem; }
  @media (min-width: 760px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cards .big { grid-column: 1 / -1; } }
  .cards a { display: flex; flex-direction: column; gap: .35rem; text-decoration: none; }
  .img { display: block; border: 1.5px solid var(--ink); border-radius: 10px; overflow: hidden; background: var(--sheet); margin-bottom: .5rem; transition: transform .25s, box-shadow .25s; }
  .img img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  @media (min-width: 760px) { .big .img img { aspect-ratio: 16 / 7; } }
  .cards a:hover .img { transform: translateY(-3px) rotate(-.4deg); box-shadow: 6px 6px 0 var(--pencil); }
  .co { font-family: var(--f-mono); font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; color: var(--pencil); }
  .t { font-family: var(--f-display); font-weight: 800; font-size: clamp(1.2rem, 2.4vw, 1.45rem); letter-spacing: -.015em; line-height: 1.2; }
  .cards a:hover .t, .index a:hover .t { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .tags { font-family: var(--f-mono); font-size: .76rem; color: var(--muted); }

  .more-h { margin-top: 4rem; }
  .index { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .index a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .2rem 1rem; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  @media (min-width: 760px) { .index a { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr) auto; } }
  .index .t { font-size: 1.1rem; }
  .st { font-size: 1.02rem; }
  @media (max-width: 759px) { .index .tags { grid-column: 1; grid-row: 2; } .index .st { grid-row: 1 / 3; grid-column: 2; align-self: center; font-size: .95rem; } }
</style>
