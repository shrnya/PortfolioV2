---
// SustainLab handoff, reconstructed: the two-level README Sharanya put at the
// front of Figma files, and her colour-coded sticky note system. Structure is
// hers; all project content here is invented.
const notes = [
  { id: 'flow', color: 'green', name: 'Start of a flow', use: 'Names the flow with a number, says what it covers, links the prototype.' },
  { id: 'branch', color: 'mint', name: 'Branch or skipped step', use: 'Extra paths inside a flow, numbered 1a, 1b, 1c.' },
  { id: 'explain', color: 'yellow', name: 'Note to developers', use: 'Explains a design element or interaction in words.' },
  { id: 'change', color: 'pink', name: 'Change to a flow', use: 'Flags something new or different on an existing screen.' },
  { id: 'update', color: 'blue', name: 'Updated since handover', use: 'Dated, and points to the newest design.' },
];
---
<div class="ho wide" data-uses={JSON.stringify(Object.fromEntries(notes.map((n) => [n.id, n.use])))}>
  <div class="tabs" role="tablist" aria-label="Handoff template">
    <button type="button" role="tab" id="ho-t1" aria-selected="true" aria-controls="ho-p1">File README</button>
    <button type="button" role="tab" id="ho-t2" aria-selected="false" aria-controls="ho-p2">Sticky notes</button>
  </div>

  <div class="panel" id="ho-p1" role="tabpanel" aria-labelledby="ho-t1">
    <div class="readme">
      <div class="r-head">
        <p class="r-title">Project title</p>
        <p class="r-status"><b>Handed over to dev</b><span>Design last updated: 12 Oct</span></p>
      </div>
      <div class="r-grid">
        <div class="card c-teal"><p class="h">User story and acceptance criteria</p><p>Linked ticket, synced from Jira, so the “why” is one glance away.</p><div class="ticket"><span>PROJ-101</span> As a manager, I want to group people by role…</div></div>
        <div class="card"><p class="h">Checklist of flows</p>
          <ul class="check">
            <li><i class="done"></i>List page: filter by status</li>
            <li><i class="done"></i>Edit roles</li>
            <li><i class="prog"></i>Long lists of entities</li>
            <li><i class="todo"></i>Emails for each step</li>
          </ul>
          <p class="key"><i class="todo"></i>to do <i class="prog"></i>in progress <i class="done"></i>done</p>
        </div>
        <div class="card"><p class="h">Status, and what may still change</p><p>What this handoff covers, and which parts are waiting on feedback.</p></div>
        <div class="card"><p class="h">Handover recording</p><p>The walkthrough meeting, linked for anyone who missed it.</p></div>
        <div class="card"><p class="h">Notes colour coding</p><ul class="legend-mini">{notes.map((n) => <li><i class={n.color}></i>{n.name}</li>)}</ul></div>
        <div class="card"><p class="h">File structure</p><p>A short video on how pages in the file are organised.</p></div>
      </div>
    </div>
    <p class="hand cap">Every page also gets its own small README with its tickets and checklist, so a developer landing on any page has the context.</p>
  </div>

  <div class="panel" id="ho-p2" role="tabpanel" aria-labelledby="ho-t2" hidden>
    <div class="legend" role="group" aria-label="Show one kind of note">
      {notes.map((n) => <button type="button" data-k={n.id} aria-pressed="false"><i class={n.color}></i>{n.name}</button>)}
    </div>
    <p class="use" aria-live="polite">Pick a colour to see where it’s used.</p>
    <div class="canvas" data-on="">
      <div class="screen s1" aria-hidden="true"><span class="b w50"></span><span class="row"></span><span class="row"></span><span class="row"></span><span class="row"></span></div>
      <div class="screen s2" aria-hidden="true"><span class="b w40"></span><span class="tbl"></span><span class="row"></span><span class="row"></span></div>
      <div class="screen s3" aria-hidden="true"><span class="b w60"></span><span class="row"></span><span class="acc"></span><span class="acc"></span></div>
      <svg class="arrows boil" viewBox="0 0 600 300" preserveAspectRatio="none" aria-hidden="true">
        <path d="M232 118 C 270 118, 280 150, 312 150" /><path d="M500 132 C 520 132, 520 168, 540 175" />
      </svg>
      <div class="sticky green" data-k="flow"><b>1. Filtering the list</b><span>by status, company and time</span><u>Prototype ▶</u></div>
      <div class="sticky mint" data-k="branch"><b>1a. Side panel</b><span>for every status</span></div>
      <div class="sticky yellow" data-k="explain">When the user clicks “Expand all”</div>
      <div class="sticky pink" data-k="change">New: filter and batch invite</div>
      <div class="sticky blue" data-k="update">12 Oct: updated since handover. Newest design here →</div>
    </div>
  </div>
</div>

<style>
  .ho { display: flex; flex-direction: column; gap: 1rem; max-width: 52rem; }
  .ho { --green: #7CCB86; --mint: #A7DFC2; --yellow: #F4D46B; --pink: #F2A6E0; --blue: #9DC8F5; --st-ink: #1C2330; }
  .tabs { display: inline-flex; align-self: flex-start; border: 1.5px solid var(--ink); border-radius: 999px; overflow: hidden; }
  .tabs button { font: 600 .88rem var(--f-display); border: 0; background: transparent; color: var(--ink); padding: .4rem 1.1rem; cursor: pointer; }
  .tabs button[aria-selected="true"] { background: var(--ink); color: var(--paper); }
  .panel { display: flex; flex-direction: column; gap: .7rem; }
  .cap { font-size: 1rem; }

  .readme { font-family: var(--f-app); color: var(--app-text); background: var(--app-surface); border: 1px solid var(--app-line); border-radius: 10px; padding: 1.1rem; display: flex; flex-direction: column; gap: 1rem; }
  .r-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: .5rem 1rem; padding-bottom: .8rem; border-bottom: 5px solid var(--mint); }
  .r-title { font-size: 1.5rem; font-weight: 600; }
  .r-status { display: flex; flex-direction: column; align-items: flex-end; font-size: .78rem; color: var(--app-sub); }
  .r-status b { color: #C2338F; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; font-size: .82rem; }
  .r-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); gap: .75rem; }
  .card { background: var(--app-bg); border: 1px solid var(--app-line); border-radius: 8px; padding: .8rem .9rem; font-size: .8rem; color: var(--app-sub); display: flex; flex-direction: column; gap: .4rem; min-width: 0; }
  .card.c-teal { background: color-mix(in srgb, var(--mint) 22%, var(--app-surface)); }
  .card .h { font-weight: 600; font-size: .9rem; color: var(--app-text); }
  .ticket { font-size: .74rem; background: var(--app-surface); border: 1px solid var(--app-line); border-radius: 6px; padding: .4rem .5rem; color: var(--app-text); }
  .ticket span { color: var(--app-accent); font-weight: 600; margin-right: .3rem; }
  .check, .legend-mini { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .3rem; color: var(--app-text); }
  .check li, .legend-mini li, .key { display: flex; align-items: center; gap: .4rem; }
  .key { font-size: .7rem; gap: .3rem; flex-wrap: wrap; }
  .check i, .key i { width: .6rem; height: .6rem; border-radius: 50%; flex: none; }
  .todo { background: var(--app-accent); } .prog { background: #E8902A; } .done { background: #2E9B57; border-radius: 2px !important; }
  .legend-mini i, .legend i { width: 1.4rem; height: .7rem; border-radius: 2px; flex: none; }
  i.green { background: var(--green); } i.mint { background: var(--mint); } i.yellow { background: var(--yellow); } i.pink { background: var(--pink); } i.blue { background: var(--blue); }

  .legend { display: flex; flex-wrap: wrap; gap: .4rem; }
  .legend button { display: inline-flex; align-items: center; gap: .45rem; font: 600 .82rem var(--f-display); color: var(--ink); background: var(--paper); border: 1.5px solid var(--rule); border-radius: 999px; padding: .3rem .75rem; cursor: pointer; }
  .legend button[aria-pressed="true"] { border-color: var(--ink); }
  .use { font-size: .95rem; color: var(--muted); min-height: 1.5em; }

  .canvas { position: relative; aspect-ratio: 2 / 1; min-height: 17rem; background: #D9DADD; border-radius: 10px; overflow: hidden; font-family: var(--f-app); }
  .screen { position: absolute; background: #fff; border-radius: 4px; padding: .5rem; display: flex; flex-direction: column; gap: .3rem; box-shadow: 0 1px 2px rgba(0, 0, 0, .1); }
  .s1 { left: 6%; top: 30%; width: 32%; height: 52%; } .s2 { left: 52%; top: 30%; width: 32%; height: 52%; } .s3 { left: 89%; top: 50%; width: 26%; height: 46%; }
  .screen .b { height: .45rem; background: #AEB3BC; border-radius: 2px; } .w50 { width: 50%; } .w40 { width: 40%; } .w60 { width: 60%; }
  .screen .row { height: .9rem; border: 1px solid #E3E5E9; border-radius: 2px; }
  .screen .tbl { height: .8rem; background: #3C4554; border-radius: 2px; }
  .screen .acc { height: .7rem; border-bottom: 1px solid #E3E5E9; }
  .arrows { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .arrows path { fill: none; stroke: #8A5CF6; stroke-width: 1.6; }
  .sticky { position: absolute; color: var(--st-ink); font-size: clamp(.62rem, 1.3vw, .8rem); line-height: 1.3; padding: .45rem .55rem; box-shadow: 0 2px 6px rgba(0, 0, 0, .15); display: flex; flex-direction: column; gap: .1rem; transition: opacity .25s, transform .25s; max-width: 30%; }
  .sticky b { font-weight: 700; } .sticky u { font-weight: 600; }
  .sticky.green { background: var(--green); left: 3%; top: 6%; }
  .sticky.mint { background: var(--mint); left: 40%; top: 6%; }
  .sticky.yellow { background: var(--yellow); left: 24%; top: 86%; }
  .sticky.pink { background: var(--pink); left: 62%; top: 6%; }
  .sticky.blue { background: var(--blue); left: 62%; top: 86%; }
  .canvas:not([data-on=""]) .sticky { opacity: .2; }
  .canvas[data-on="flow"] .sticky[data-k="flow"], .canvas[data-on="branch"] .sticky[data-k="branch"], .canvas[data-on="explain"] .sticky[data-k="explain"],
  .canvas[data-on="change"] .sticky[data-k="change"], .canvas[data-on="update"] .sticky[data-k="update"] { opacity: 1; transform: scale(1.06) rotate(-1deg); z-index: 2; }
  @media (max-width: 560px) { .canvas { aspect-ratio: auto; min-height: 22rem; } .sticky { max-width: 42%; } .sticky.mint { left: 50%; top: 4%; } .sticky.pink { left: 52%; top: 20%; } }
</style>

<script>
  const ho = document.querySelector<HTMLElement>('.ho');
  if (ho) {
    const tabs = ho.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); (document.getElementById(x.getAttribute('aria-controls')!) as HTMLElement).hidden = !on; });
    }));
    const canvas = ho.querySelector<HTMLElement>('.canvas')!;
    const use = ho.querySelector('.use')!;
    const uses: Record<string, string> = JSON.parse(ho.dataset.uses || '{}');
    ho.querySelectorAll<HTMLButtonElement>('.legend button').forEach((b, _, all) => b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      all.forEach((x) => x.setAttribute('aria-pressed', String(x === b && on)));
      canvas.dataset.on = on ? b.dataset.k! : '';
      use.textContent = on ? uses[b.dataset.k!] : 'Pick a colour to see where it’s used.';
    }));
  }
</script>
