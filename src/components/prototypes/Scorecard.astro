---
// Dashboard demo: one scorecard structure, KPIs swapped per industry.
// Telecom adds the one dedicated widget (grid vs diesel). Invented values.
type Kpi = { k: string; v: string; u: string; d: string; good: boolean; trend: number[]; swap?: boolean };
const sets: { id: string; label: string; kpis: Kpi[]; extra?: boolean }[] = [
  { id: 'cre', label: 'Commercial building', kpis: [
    { k: 'Energy used', v: '41,280', u: 'kWh', d: '−4% vs last month', good: true, trend: [8, 9, 7, 8, 6, 7, 6] },
    { k: 'SEC', v: '12.6', u: 'kWh/m²', d: '−3% vs last month', good: true, trend: [7, 8, 8, 7, 6, 6, 5], swap: true },
    { k: 'Energy cost', v: '₹3.9L', u: '', d: '−2% vs last month', good: true, trend: [6, 7, 7, 6, 6, 6, 5] },
    { k: 'Carbon', v: '29.3', u: 't CO₂e', d: '−4% vs last month', good: true, trend: [8, 8, 7, 7, 6, 6, 6] },
  ] },
  { id: 'dc', label: 'Data centre', kpis: [
    { k: 'Energy used', v: '1.92', u: 'GWh', d: '+1% vs last month', good: false, trend: [6, 6, 7, 7, 7, 7, 8] },
    { k: 'PUE', v: '1.48', u: '', d: '−0.04 vs last month', good: true, trend: [8, 8, 7, 7, 6, 6, 6], swap: true },
    { k: 'Energy cost', v: '₹1.6Cr', u: '', d: '+1% vs last month', good: false, trend: [6, 6, 6, 7, 7, 7, 7] },
    { k: 'Carbon', v: '1,363', u: 't CO₂e', d: '+1% vs last month', good: false, trend: [6, 6, 7, 7, 7, 8, 8] },
  ] },
  { id: 'tel', label: 'Telecom site', extra: true, kpis: [
    { k: 'Energy used', v: '6,410', u: 'kWh', d: '−1% vs last month', good: true, trend: [7, 7, 7, 6, 7, 6, 6] },
    { k: 'Diesel share', v: '18', u: '%', d: '+5 pts vs last month', good: false, trend: [4, 4, 5, 5, 6, 7, 7], swap: true },
    { k: 'Energy cost', v: '₹71K', u: '', d: '+6% vs last month', good: false, trend: [5, 5, 6, 6, 6, 7, 7] },
    { k: 'Carbon', v: '5.2', u: 't CO₂e', d: '+4% vs last month', good: false, trend: [5, 6, 6, 6, 7, 7, 7] },
  ] },
];
const spark = (t: number[]) => 'M' + t.map((v, i) => `${i * 10} ${24 - v * 2.4}`).join('L');
// 24 hours of grid / diesel / both, for the telecom widget
const hours = 'ggggggdddggggggbbgggggdd'.split('');
---
<div class="sc wide" data-sc>
  <div class="tabs" role="tablist" aria-label="Industry">
    {sets.map((s, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={s.id}>{s.label}</button>)}
  </div>
  {sets.map((s, i) => (
    <div class="app" role="tabpanel" data-panel={s.id} hidden={i !== 0}>
      <div class="bar"><span class="t">Facility overview</span><span class="sub">This month</span></div>
      <div class="cards">
        {s.kpis.map((k) => (
          <div class:list={['card', { swap: k.swap }]}>
            <p class="k">{k.k}</p>
            <p class="v">{k.v}<span>{k.u}</span></p>
            <svg viewBox="0 0 60 24" aria-hidden="true"><path d={spark(k.trend)} /></svg>
            <p class:list={['d', k.good ? 'good' : 'bad']}>{k.d}</p>
          </div>
        ))}
      </div>
      {s.extra && (
        <div class="extra">
          <div class="eh"><p class="et">Grid vs diesel, today</p><p class="legend"><i class="g"></i>Grid <i class="dd"></i>Diesel <i class="b"></i>Both at once</p></div>
          <div class="hours" aria-label="Hour by hour: mostly grid, diesel for 5 hours, both running for 2 hours">
            {hours.map((h) => <span class={h} />)}
          </div>
          <p class="axis"><span>00:00</span><span>12:00</span><span>23:00</span></p>
        </div>
      )}
    </div>
  ))}
  <p class="hand cap">Same cards, same places. Only the highlighted KPI changes, and telecom gets one extra widget.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-sc]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const pick = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== id; });
    };
    tabs.forEach((t) => t.addEventListener('click', () => pick(t.dataset.tab!)));
  });
</script>

<style>
  .sc { display: flex; flex-direction: column; gap: .7rem; }
  .tabs { display: flex; flex-wrap: wrap; gap: .4rem; }
  .tabs button { font: 600 .85rem var(--f-display); color: var(--ink); background: none; border: 1.5px solid var(--pencil); border-radius: 999px; padding: .3rem .85rem; cursor: pointer; }
  .tabs button[aria-selected="true"] { background: var(--pencil); color: var(--paper); }
  .app { font-family: var(--f-app); color: var(--app-text); background: var(--app-bg); border: 1px solid var(--app-line); border-radius: 10px; overflow: hidden; }
  .bar { display: flex; justify-content: space-between; align-items: center; padding: .6rem 1rem; background: var(--app-surface); border-bottom: 1px solid var(--app-line); font-size: .8rem; }
  .bar .t { font-weight: 600; font-size: .88rem; } .bar .sub { color: var(--app-sub); }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; padding: .8rem; }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .card { background: var(--app-surface); border: 1px solid var(--app-line); border-radius: 8px; padding: .7rem .8rem; display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .card.swap { border-color: var(--app-accent); box-shadow: 0 0 0 2px var(--app-accent-soft); }
  .k { font-size: .74rem; color: var(--app-sub); }
  .swap .k { color: var(--app-accent); font-weight: 600; }
  .v { font-size: 1.3rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .v span { font-size: .72rem; font-weight: 400; color: var(--app-sub); margin-left: .25rem; }
  svg { width: 100%; height: 1.4rem; }
  svg path { fill: none; stroke: var(--app-accent); stroke-width: 1.6; stroke-linejoin: round; }
  .d { font-size: .7rem; }
  .good { color: var(--app-good); } .bad { color: var(--app-warn); }
  .extra { margin: 0 .8rem .8rem; background: var(--app-surface); border: 1px solid var(--app-accent); border-radius: 8px; padding: .7rem .8rem; display: flex; flex-direction: column; gap: .45rem; }
  .eh { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .3rem 1rem; align-items: baseline; }
  .et { font-size: .82rem; font-weight: 600; }
  .legend { display: flex; align-items: center; gap: .3rem; font-size: .7rem; color: var(--app-sub); flex-wrap: wrap; }
  .legend i { width: .7rem; height: .7rem; border-radius: 2px; display: inline-block; margin-left: .4rem; }
  .g, .legend .g { background: var(--app-accent-soft); }
  .dd, .legend .dd { background: #8A93A3; }
  .b, .legend .b { background: var(--app-warn); }
  .hours { display: grid; grid-template-columns: repeat(24, minmax(0, 1fr)); gap: 2px; }
  .hours span { height: 1.4rem; border-radius: 2px; }
  .hours .g { background: var(--app-accent-soft); } .hours .d { background: #8A93A3; } .hours .b { background: var(--app-warn); }
  .axis { display: flex; justify-content: space-between; font-size: .66rem; color: var(--app-sub); }
  .cap { font-size: 1rem; }
</style>
