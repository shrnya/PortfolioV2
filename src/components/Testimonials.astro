---
// Quotes from people Sharanya has worked with, one at a time.
// Swipe or scroll on touch; arrows and dots everywhere else.
import { line } from '../lib/rough';
interface Quote { text: string; name: string; role: string; photo?: string; href?: string }
interface Props { quotes: Quote[] }
const { quotes } = Astro.props;
const mark = line(4, 30, 26, 4, 41, 2) + line(22, 34, 44, 8, 42, 2);
---
<div class="tm" data-tm>
  <div class="track" tabindex="0" aria-label="What people say" data-track>
    {quotes.map((q, i) => (
      <figure class="slide" aria-label={`${i + 1} of ${quotes.length}`}>
        <svg class="mark boil" viewBox="0 0 48 38" aria-hidden="true"><path d={mark} /></svg>
        <blockquote>{q.text}</blockquote>
        <figcaption>
          {q.photo ? <img class="face" src={q.photo} alt="" width="56" height="56" loading="lazy" /> : <span class="face blank" aria-hidden="true">{q.name[0]}</span>}
          <span><b>{q.href ? <a href={q.href} rel="noopener">{q.name}</a> : q.name}</b><br />{q.role}</span>
        </figcaption>
      </figure>
    ))}
  </div>
  {quotes.length > 1 && (
    <div class="ctl">
      <button type="button" class="arrow" data-prev aria-label="Previous quote">←</button>
      <div class="dots">{quotes.map((_, i) => <button type="button" class="dot" data-dot={i} aria-label={`Quote ${i + 1}`} />)}</div>
      <button type="button" class="arrow" data-next aria-label="Next quote">→</button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tm]').forEach((tm) => {
    const track = tm.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...tm.querySelectorAll<HTMLElement>('[data-dot]')];
    const at = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: ((i + slides.length) % slides.length) * track.clientWidth, behavior: 'smooth' });
    const mark = () => dots.forEach((d, i) => d.setAttribute('aria-current', String(i === at())));
    tm.querySelector('[data-prev]')?.addEventListener('click', () => go(at() - 1));
    tm.querySelector('[data-next]')?.addEventListener('click', () => go(at() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('scroll', () => requestAnimationFrame(mark), { passive: true });
    mark();
  });
</script>

<style>
  .tm { display: flex; flex-direction: column; gap: 1.1rem; }
  .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 22px; }
  .track::-webkit-scrollbar { display: none; }
  .slide {
    flex: 0 0 100%; scroll-snap-align: start; margin: 0; padding: 2.2rem clamp(1.25rem, 4vw, 3rem) 2rem;
    background: var(--pencil); color: #fff; display: flex; flex-direction: column; gap: 1.4rem; min-width: 0;
  }
  .mark { width: 3rem; height: 2.4rem; overflow: visible; }
  .mark path { fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; }
  blockquote { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: clamp(1.15rem, 2.3vw, 1.55rem); line-height: 1.4; letter-spacing: -.01em; max-width: 46rem; }
  figcaption { display: flex; align-items: center; gap: .85rem; font-family: var(--f-display); font-size: .95rem; line-height: 1.35; }
  figcaption a { color: inherit; }
  .face { width: 3.4rem; height: 3.4rem; border-radius: 50%; object-fit: cover; border: 2px solid #fff; flex: none; }
  .blank { display: grid; place-items: center; font-family: var(--f-hand); font-size: 1.4rem; }
  .ctl { display: flex; align-items: center; gap: 1rem; }
  .arrow { font: 600 1.1rem var(--f-display); width: 2.6rem; height: 2.6rem; border-radius: 50%; border: 1.5px solid var(--ink); background: var(--paper); color: var(--ink); cursor: pointer; }
  .arrow:hover { background: var(--ink); color: var(--paper); }
  .dots { display: flex; gap: .5rem; }
  .dot { width: .7rem; height: .7rem; border-radius: 50%; border: 1.5px solid var(--ink); background: transparent; padding: 0; cursor: pointer; }
  .dot[aria-current="true"] { background: var(--ink); }
</style>
