---
// Drawn figure: one SLD node, labelled. Placeholder line art.
import { rect, arrow, ellipse } from '../../lib/rough';
const node = rect(170, 90, 230, 64, 61, 1.2);
const callouts = [
  { a: arrow(110, 40, 196, 104, 62), x: 100, y: 32, t: 'online or offline' },
  { a: arrow(286, 26, 250, 100, 63), x: 300, y: 20, t: 'its name' },
  { a: arrow(470, 46, 380, 104, 64), x: 470, y: 38, t: 'alerts and insights' },
  { a: arrow(470, 200, 360, 142, 65), x: 470, y: 216, t: 'load now, or energy for 24h / 7d / 30d' },
  { a: arrow(110, 196, 180, 146, 66), x: 110, y: 214, t: 'orange = take a look' },
];
const circ = ellipse(380, 108, 18, 14, 67, 1);
---
<figure class="na wide">
  <svg class="boil" viewBox="0 0 600 240" role="img" aria-label="An SLD node: a box with an online dot, its name, alert and insight badges, and its load or energy value. It turns orange when something needs a look.">
    <rect class="fill" x="170" y="90" width="230" height="64" rx="6" />
    <path class="hot" d={node} />
    <circle class="dot" cx="196" cy="110" r="6" />
    <text x="212" y="115" class="nm">Transformer 1</text>
    <text x="370" y="114" class="bd">⚠ 1</text>
    <text x="212" y="140" class="kw">2,140 kW</text>
    <path class="thin" d={circ} />
    {callouts.map((c) => <><path class="thin" d={c.a} /><text x={c.x} y={c.y} class="hand" text-anchor="middle">{c.t}</text></>)}
  </svg>
</figure>

<style>
  .na { margin: 1.5rem 0; overflow-x: auto; }
  svg { width: 100%; min-width: 520px; max-width: 46rem; height: auto; overflow: visible; padding: 0 .5rem; box-sizing: border-box; }
  path { fill: none; stroke: var(--pencil); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .fill { fill: color-mix(in srgb, #E07A12 10%, var(--paper)); }
  .hot { stroke: #E07A12; stroke-width: 2.4; }
  .thin { stroke-width: 1.2; }
  .dot { fill: #1E9A5A; }
  text { font: 600 15px var(--f-app); fill: var(--ink); }
  .kw { font-weight: 400; font-size: 14px; }
  .bd { fill: #E07A12; font-size: 13px; }
  .hand { font: 400 16px var(--f-hand); fill: var(--pencil); }
</style>
