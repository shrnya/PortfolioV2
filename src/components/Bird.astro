---
// A small hand-drawn bird perched on the hero figure. Click it, or hover,
// and it hops and says hello. Drawn from the rough helpers in blue ink;
// swap for Sharanya's own drawing when she has one.
import { ellipse, poly, line } from '../lib/rough';
const body = ellipse(34, 34, 17, 11.5, 201, .9);
const head = ellipse(51, 22, 8.5, 8, 202, .6);
const wing = poly([[24, 30], [34, 27], [42, 33], [31, 37], [24, 30]], 203, .6);
const tail = poly([[18, 33], [4, 26], [7, 36], [18, 38]], 204, .6);
const beak = poly([[59, 20], [66, 22.5], [59, 25]], 205, .3);
const legs = line(31, 45, 30, 54, 206, .3) + line(38, 45, 39, 54, 207, .3);
const toes = line(26, 54, 34, 54, 208, .3) + line(35, 54, 43, 54, 209, .3);
---
<button class="bird" type="button" aria-label="A small bird says hello">
  <span class="bubble" aria-hidden="true">hi! drag the line ↓</span>
  <svg class="boil" viewBox="0 0 70 58" aria-hidden="true">
    <path class="fill" d={body} />
    <path class="fill" d={head} />
    <path d={body} /><path d={head} /><path d={wing} /><path d={tail} />
    <path d={beak} /><path d={legs} /><path d={toes} />
    <circle class="eye" cx="53.5" cy="20.5" r="1.6" />
  </svg>
</button>

<style>
  .bird { position: relative; display: block; border: 0; padding: 0; background: none; cursor: pointer; width: 5.4rem; color: var(--pencil); }
  svg { width: 100%; height: auto; display: block; overflow: visible; transform-origin: 50% 100%; }
  path { fill: none; stroke: var(--pencil); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  path.fill { fill: var(--paper); stroke: none; }
  .eye { fill: var(--ink); }
  .bubble {
    position: absolute; bottom: 70%; right: 92%; white-space: nowrap;
    font: 700 .95rem/1 var(--f-hand); color: var(--pencil); background: var(--paper);
    border: 1.5px solid var(--pencil); border-radius: 1rem; padding: .35rem .7rem;
    opacity: 0; transform: translateY(4px); transition: opacity .2s, transform .2s; pointer-events: none;
  }
  .bird:hover .bubble, .bird:focus-visible .bubble, .bird.hop .bubble { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .bird svg { animation: idle 4.5s ease-in-out infinite; }
    .bird.hop svg { animation: hop .55s cubic-bezier(.3, 1.4, .5, 1); }
  }
  @keyframes idle { 0%, 86%, 100% { transform: none; } 90% { transform: rotate(-6deg); } 94% { transform: rotate(3deg); } }
  @keyframes hop { 0% { transform: none; } 35% { transform: translateY(-14px) rotate(-8deg); } 70% { transform: translateY(0) scaleY(.9); } 100% { transform: none; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.bird').forEach((b) => {
    const hop = () => { b.classList.remove('hop'); void b.offsetWidth; b.classList.add('hop'); };
    b.addEventListener('click', hop);
    b.addEventListener('mouseenter', hop);
    b.querySelector('svg')?.addEventListener('animationend', (e) => { if ((e as AnimationEvent).animationName.includes('hop')) setTimeout(() => b.classList.remove('hop'), 1200); });
  });
</script>
