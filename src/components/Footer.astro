---
import { ellipse } from '../lib/rough';
const loop = ellipse(60, 22, 56, 17, 11);
---
<footer id="contact" class="foot sheet">
  <div class="end">
    <p class="eyebrow">Contact</p>
    <h2>Working on something <span class="circled">complicated?<svg class="boil" viewBox="0 0 120 44" aria-hidden="true" preserveAspectRatio="none"><path d={loop} /></svg></span> I'd love to hear about it.</h2>
  </div>
  <ul class="links">
    <li><span class="k">Email</span> <a href="mailto:sharanyajc@gmail.com?subject=Let%27s%20talk">sharanyajc@gmail.com</a></li>
    <li><span class="k">LinkedIn</span> <a href="https://www.linkedin.com/in/sharanyajc" rel="noopener">linkedin.com/in/sharanyajc</a></li>
    <li><span class="k">Résumé</span> <a href="https://drive.google.com/file/d/15tVwUM-jkmzby2MVAa0smwRkCzmqHJ-Z/view" rel="noopener">Open the PDF ↗</a></li>
  </ul>
  <p class="small">Designed and built by Sharanya.</p>
</footer>

<style>
  .foot { padding-block: clamp(3rem, 8vw, 6rem) 3rem; display: flex; flex-direction: column; gap: 1.5rem; border-top: 1.5px solid var(--ink); margin-top: clamp(3.5rem, 8vw, 6rem); }
  .end { display: flex; flex-direction: column; gap: .6rem; max-width: 44rem; }
  h2 { font-size: clamp(1.7rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -.02em; }
  .circled { position: relative; white-space: nowrap; margin-right: .25em; }
  .circled svg { position: absolute; inset: -18% -8% -22% -8%; width: 116%; height: 140%; overflow: visible; pointer-events: none; max-width: none; }
  .circled path { fill: none; stroke: var(--pencil); stroke-width: 1.8; stroke-linecap: round; }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .75rem 2rem; }
  .links li { display: flex; gap: .6rem; align-items: baseline; min-width: 0; }
  .links a { font-family: var(--f-display); font-weight: 600; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .k { font-family: var(--f-mono); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .small { font-family: var(--f-mono); font-size: .75rem; color: var(--muted); }
</style>
